{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow Local",
  "version": "0.1.0",
  "identifier": "com.voiceflow.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceFlow Local",
        "width": 760,
        "height": 760,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "VoiceFlow Local",
    "copyright": "Copyright © 2026 VoiceFlow Local",
    "category": "Productivity",
    "shortDescription": "Local-first voice-to-clipboard assistant",
    "longDescription": "VoiceFlow Local turns speech into polished, paste-ready text entirely on your machine — global hotkey to record, local transcription and rewrite, then copy. No cloud, no history, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
