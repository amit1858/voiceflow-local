# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Rust / Tauri backend
src-tauri/target/
src-tauri/gen/schemas/

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Local model DATA — never commit model weights, voices, or the prebuilt
# speech-engine DLLs. These live in the app-data dir at runtime and in
# src-tauri/resources/models at package time; the Rust *source* module
# src-tauri/src/models/ is NOT a data dir and must stay tracked.
*.bin
*.gguf
*.ggml
*.onnx
*.onnx.data
tokens.txt
lexicon.txt
whisper-models/
src-tauri/models/
src-tauri/resources/
!src-tauri/resources/
src-tauri/resources/*
!src-tauri/resources/.gitkeep
# ONNX Runtime / sherpa-onnx prebuilt native libraries.
*.dll
*.dylib
*.so
*.so.*

# Local runtime / temp / config
voiceflow-*.wav
settings.json
*.local.json
.env
.env.*
!.env.example
