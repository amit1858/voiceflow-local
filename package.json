{
  "name": "voiceflow-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first voice-to-clipboard desktop assistant",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:sherpa": "tauri dev --features sherpa",
    "prepare:release-models": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\prepare-release-models.ps1",
    "tauri:build": "npm run prepare:release-models && tauri build --target x86_64-pc-windows-msvc --features sherpa --no-bundle && tauri bundle --target x86_64-pc-windows-msvc --features sherpa --config src-tauri/tauri.release.conf.json --bundles nsis msi",
    "tauri:build:sherpa": "npm run tauri:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
